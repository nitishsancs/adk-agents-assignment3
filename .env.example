# --- Model backend (pick one) ---
# Option 1: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-key-here

# Option 2: Vertex AI (needs a billing-enabled GCP project + `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Models (override per agent if you want) ---
FAST_MODEL=gemini-flash-latest
SMART_MODEL=gemini-flash-latest

# --- MCP Toolbox for Databases (parts c and e) ---
MCP_TOOLBOX_URL=http://127.0.0.1:5050

# --- GitHub MCP server (part c, optional) ---
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Web research backend for (a) and (c) ---
# google = built-in Google Search grounding (needs grounding quota; not on the free tier)
# ddg    = keyless DuckDuckGo search + page fetch
SEARCH_BACKEND=google
